{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/login/index",
      "style": {
        "navigationBarTitleText": "登录",
        "navigationStyle": "custom",
        "backgroundColor": "#EEF1FF"
      }
    },
    {
      "path": "pages/menu/index",
      "style": {
        "navigationBarTitleText": "今天吃什么",
        "navigationBarBackgroundColor": "#F1F4FF",
        "backgroundColor": "#EEF1FF"
      }
    },
    {
      "path": "pages/menu/detail",
      "style": {
        "navigationBarTitleText": "菜品详情"
      }
    },
    {
      "path": "pages/cart/index",
      "style": {
        "navigationBarTitleText": "购物车",
        "navigationBarBackgroundColor": "#F1F4FF",
        "backgroundColor": "#EEF1FF"
      }
    },
    {
      "path": "pages/mine/index",
      "style": {
        "navigationBarTitleText": "个人中心",
        "navigationBarBackgroundColor": "#F1F4FF",
        "backgroundColor": "#EEF1FF"
      }
    },
    {
      "path": "pages/kitchen/waiting",
      "style": {
        "navigationBarTitleText": "待接单",
        "navigationStyle": "custom",
        "backgroundColor": "#EEF1FF"
      }
    },
    {
      "path": "pages/kitchen/cooking",
      "style": {
        "navigationBarTitleText": "制作中",
        "navigationStyle": "custom",
        "backgroundColor": "#EEF1FF"
      }
    },
    {
      "path": "pages/order/confirm",
      "style": {
        "navigationBarTitleText": "确认下单"
      }
    },
    {
      "path": "pages/order/list",
      "style": {
        "navigationBarTitleText": "我的订单"
      }
    },
    {
      "path": "pages/order/detail",
      "style": {
        "navigationBarTitleText": "订单详情"
      }
    },
    {
      "path": "pages/review/edit",
      "style": {
        "navigationBarTitleText": "写评价"
      }
    },
    {
      "path": "pages/review/list",
      "style": {
        "navigationBarTitleText": "我的评价"
      }
    },
    {
      "path": "pages/proposal/edit",
      "style": {
        "navigationBarTitleText": "提交新菜"
      }
    },
    {
      "path": "pages/proposal/list",
      "style": {
        "navigationBarTitleText": "我的提案"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "家里吃什么",
    "navigationBarBackgroundColor": "#F1F4FF",
    "backgroundColor": "#EEF1FF",
    /* 页面转场动画（仅 App 端生效；H5/小程序忽略）。
       底部 tab 走 reLaunch，不受这里影响。 */
    "app-plus": {
      "animationType": "fade-in",
      "animationDuration": 250
    }
  }
}
